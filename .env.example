# ============================================================
# CONTOH KONFIGURASI LINGKUNGAN
# Salin file ini menjadi ".env" lalu isi dengan nilai milikmu.
# JANGAN pernah commit file .env ke GitHub!
# ============================================================

# ---------- Google Cloud (Service Account) ----------
# Path ke file JSON kredensial service account
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ID spreadsheet Google Sheets tempat data kehadiran disimpan
SPREADSHEET_ID=
# Range sheet tujuan (default: Sheet1!A:D)
SHEET_RANGE=Sheet1!A:D
# ID folder Google Drive tempat foto kehadiran diunggah
DRIVE_FOLDER_ID=

# ---------- Kamera CCTV (RTSP) ----------
RTSP_USERNAME=admin
RTSP_PASSWORD=
RTSP_IP=192.168.1.100
RTSP_PORT=554
RTSP_PATH=/ch=1?subtype=0

# ---------- Model wajah terlatih ----------
OUTPUT_MODEL=trained_models/trained_faces_insightface480l.pkl

# ---------- WAHA (WhatsApp HTTP API) ----------
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# ---------- Ngrok / URL publik n8n ----------
N8N_PUBLIC_URL=https://your-domain.ngrok-free.dev
